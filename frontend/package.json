{
  "name": "ifinbrain-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "type-check": "vue-tsc --noEmit",
    "verify:expr": "npm run verify:expr:core && npm run verify:expr:reactivity",
    "verify:expr:core": "esbuild scripts/expr-verify/verify.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/ifin-expr-core.mjs --log-level=warning && node node_modules/.cache/ifin-expr-core.mjs",
    "verify:expr:reactivity": "esbuild scripts/expr-verify/reactivity.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/ifin-expr-reactivity.mjs --log-level=warning && node node_modules/.cache/ifin-expr-reactivity.mjs",
    "verify:layout": "esbuild scripts/form-verify/layout.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/ifin-form-layout.mjs --log-level=warning && node node_modules/.cache/ifin-form-layout.mjs",
    "verify:identity": "esbuild scripts/form-verify/identity.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/ifin-form-identity.mjs --log-level=warning && node node_modules/.cache/ifin-form-identity.mjs",
    "verify:table-columns": "esbuild scripts/form-verify/table-columns.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/ifin-form-table-columns.mjs --log-level=warning && node node_modules/.cache/ifin-form-table-columns.mjs",
    "verify:render": "esbuild scripts/form-verify/render.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/ifin-form-render.mjs --log-level=warning && node node_modules/.cache/ifin-form-render.mjs",
    "verify": "npm run verify:expr && npm run verify:layout && npm run verify:identity && npm run verify:table-columns && npm run verify:table-scroll && npm run verify:source-params && npm run verify:render",
    "verify:source-params": "esbuild scripts/form-verify/source-params.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/ifin-form-source-params.mjs --log-level=warning && node node_modules/.cache/ifin-form-source-params.mjs",
    "verify:table-scroll": "esbuild scripts/form-verify/table-scroll.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/ifin-form-table-scroll.mjs --log-level=warning && node node_modules/.cache/ifin-form-table-scroll.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@element-plus/icons-vue": "^2.3.1",
    "@file-viewer/capability-text-tools": "^3.1.2",
    "@file-viewer/core": "^3.1.2",
    "@file-viewer/preset-office": "^3.1.2",
    "@file-viewer/renderer-image": "^3.1.2",
    "@file-viewer/renderer-text": "^3.1.2",
    "@file-viewer/vite-plugin": "^3.1.2",
    "@file-viewer/vue3": "^3.1.2",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.0",
    "@vue-flow/minimap": "^1.5.4",
    "axios": "^1.7.9",
    "dagre": "^0.8.5",
    "dayjs": "^1.11.13",
    "dompurify": "^3.4.16",
    "echarts": "^5.6.0",
    "element-plus": "^2.9.1",
    "marked": "^14.0.0",
    "monaco-editor": "^0.56.0",
    "nprogress": "^0.2.0",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-i18n": "^11.4.12",
    "vue-router": "^4.5.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.52",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.10.5",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.2",
    "unplugin-auto-import": "^0.18.6",
    "unplugin-vue-components": "^0.27.5",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  }
}
