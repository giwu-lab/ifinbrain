# ifinbrain — required at runtime
# Copy to .env and fill in real values before `docker compose up -d`.

# ===== JWT 签名密钥 =====
# 必须 ≥32 字节随机串；不同环境请用不同值（推荐 `openssl rand -base64 32`）
JWT_ACCESS_SECRET=

# ===== fapiao_cn（外部 OCR 服务）=====
# base-url 与 api-key 不在 .env 中；请在 系统 → API 设置 页面配置，
# 存储到 sys_setting 表的 ocr.baseUrl / ocr.apiKey（FapiaoCnClient 直接读取）。

# ===== PostgreSQL（必填，唯一的数据库）=====
# SQLite 已弃用。dev 与 prod 连同一个 PostgreSQL 实例（需装 pgvector 扩展）。
# compose 里 SPRING_PROFILES_ACTIVE 已固定为 prod；这里一般不用改。
PG_HOST=
PG_PORT=5432
PG_DB=ifinbrain
PG_USER=fapiao
PG_PASSWORD=
# 如有自定义 JDBC 参数：
# PG_QUERY_STRING=?sslmode=require

# ===== 主加密密钥（AES-256-GCM）=====
# 用于加密 OCR/S3 等敏感字段。>= 32 字节随机串；不同环境请用不同值（openssl rand -base64 48）。
# 留空则启动时拒绝启动（CryptoUtil 强校验）。
IFINBRAIN_MASTER_KEY=